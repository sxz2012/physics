/Alt ([asy] //cache 2598626330 unitsize\(3cm\); import graph; real dx= 1.5; draw\(shift\(-dx*2,0\)*\(\(0,1.2\)--\(0,0\)--\(1.2,0\)\), Arrows\); draw\(shift\(-dx*2,0\)*\(\(1,-.05\)--\(1,.05\)\) \); label\("$1$",\(1-dx*2,-.05\),S\); label\("$r$",\(.5-dx*2,0\),S\); label\("$a$",\(-dx*2,.5\),W\); draw\(shift\(-dx*2,0\)*\(\(-.05,1\)--\(.05,1\)\) \); label\("$g$",\(-.05-dx*2,1\),W\); real f2\(real x\){ return 1 - \(x*\(1-x\)*4\); } draw\(shift\(-dx*2,0\)*graph\(f2,0,1\), blue\); label\("\(a\)",\(.5-dx*2,-.3\),S\); label\("$a = 4g\(1 - r - r^2\)$", \(-2.4,1\),N\); draw\(shift\(-dx,0\)*\(\(0,1.2\)--\(0,0\)--\(1.2,0\)\), Arrows\); draw\(shift\(-dx,0\)*\(\(1,-.05\)--\(1,.05\)\) \); label\("$1$",\(1-dx,-.05\),S\); label\("$r$",\(.5-dx,0\),S\); label\("$a$",\(-dx,.5\),W\); draw\(shift\(-dx,0\)*\(\(-.05,1\)--\(.05,1\)\) \); label\("$g$",\(-.05-dx,1\),W\); real f2\(real x\){ return x*\(1-x\)*4; } draw\(shift\(-dx,0\)*graph\(f2,0,1\), blue\); label\("\(b\)",\(.5-dx,-.3\),S\); label\("$a = 4gr\(1-r\)$",\(-1,1\),N\); draw\(\(0,1.2\)--\(0,0\)--\(1.2,0\), Arrows\); draw\(\(1,-.05\)--\(1,.05\)\); label\("$1$",\(1,-.05\),S\); label\("$r$",\(.5,0\),S\); label\("$a$",\(0,.5\),W\); draw\(\(-.05,1\)--\(.05,1\)\); label\("$g$",\(-.05,1\),W\); real f1\(real x\){ return \(1-x\)/\(1+x\); } draw\(graph\(f1,0,1\), blue\); label\("\(c\)",\(.5,-.3\),S\); label\("$a = g\\frac{1-r}{1+r}$",\(.5,1\),N\); pair delta = \(-3,-2\); draw\(shift\(delta\)*\(\(0,1.2\)--\(0,0\)--\(1.2,0\)\), Arrows\); draw\(shift\(delta\)*\(\(1,-.05\)--\(1,.05\)\)\); label\("$1$",\(1,-.05\)+delta,S\); label\("$r$",\(.5,0\)+delta,S\); label\("$a$",\(0,.5\)+delta,W\); draw\(shift\(delta\)*\(\(-.05,1\)--\(.05,1\)\)\); label\("$g$",\(-.05,1\)+delta,W\); real f1\(real x\){ return \(1+x\)/\(1-x\)/10; } draw\(shift\(delta\)*graph\(f1,0,.85\), blue\); label\("\(d\)",\(.5,-.3\)+delta,S\); label\("$a = \\frac{g}{10}\\frac{1+r}{1-r}$",\(-2.5,-1\),N\); pair delta = \(-1.5,-2\); draw\(shift\(delta\)*\(\(0,1.2\)--\(0,0\)--\(1.2,0\)\), Arrows\); draw\(shift\(delta\)*\(\(1,-.05\)--\(1,.05\)\)\); label\("$1$",\(1,-.05\)+delta,S\); label\("$r$",\(.5,0\)+delta,S\); label\("$a$",\(0,.5\)+delta,W\); draw\(shift\(delta\)*\(\(-.05,1\)--\(.05,1\)\)\); label\("$g$",\(-.05,1\)+delta,W\); real f1\(real x\){ return 1/x/10; } draw\(shift\(delta\)*graph\(f1,.08,1\), blue\); label\("\(e\)",\(.5,-.3\)+delta,S\); label\("$a = \\frac{g}{10 r}$",\(-1,-1\),N\); pair delta = \(0,-2\); draw\(shift\(delta\)*\(\(0,1.2\)--\(0,0\)--\(1.2,0\)\), Arrows\); draw\(shift\(delta\)*\(\(1,-.05\)--\(1,.05\)\)\); label\("$1$",\(1,-.05\)+delta,S\); label\("$r$",\(.5,0\)+delta,S\); label\("$a$",\(0,.5\)+delta,W\); draw\(shift\(delta\)*\(\(-.05,1\)--\(.05,1\)\)\); label\("$g$",\(-.05,1\)+delta,W\); real f1\(real x\){ return 1; } draw\(shift\(delta\)*graph\(f1,0,1\), blue\); label\("\(f\)",\(.5,-.3\)+delta,S\); label\("$a = g$",\(.5,-1\),N\); [/asy])
